# Chave da DeepSeek (https://platform.deepseek.com) — conta pré-paga,
# recomendado colocar um saldo pequeno de propósito. Ver README (seção "LLM: DeepSeek").
DEEPSEEK_API_KEY=
# LLM_PROVIDER=openrouter troca o LLM do app inteiro (chat, /compact, resumo
# do RAG) pro OpenRouter — só pra TESTE, ver README (seção "LLM: DeepSeek").
# Deixe em branco/"deepseek" (padrão) pra usar a DeepSeek direto, como acima.
# LLM_PROVIDER=openrouter
# Chave do OpenRouter (https://openrouter.ai/keys) — só necessária se
# LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Slug do modelo no catálogo do OpenRouter (formato "provider/modelo"),
# ex.: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free (gratuito).
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Chave da Voyage AI para os embeddings do RAG (https://dash.voyageai.com).
VOYAGE_API_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nx_agent_kb
POSTGRES_USER=nx_agent
POSTGRES_PASSWORD=defina_uma_senha_local
# Segredo para assinar o cookie de sessão. Gere um valor aleatório longo, ex.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=troque_por_um_valor_aleatorio_longo
# Emails (separados por vírgula) que viram admin (TI) automaticamente ao logar.
ADMIN_EMAILS=diego.herrera@schwaben.com.br
