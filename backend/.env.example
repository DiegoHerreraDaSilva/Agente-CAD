ANTHROPIC_API_KEY=
# Provider do chat: "deepseek" (default, mais barato) ou "anthropic".
# Com deepseek, DEEPSEEK_API_KEY abaixo é obrigatória; com anthropic, usa a
# chave acima. Ver README (seção "Provider de LLM: DeepSeek x Anthropic").
MODELO_PROVIDER=deepseek
# Chave da DeepSeek (https://platform.deepseek.com) — conta pré-paga,
# recomendado colocar um saldo pequeno de propósito.
DEEPSEEK_API_KEY=
# Chave da Voyage AI para os embeddings do RAG (https://dash.voyageai.com).
VOYAGE_API_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nx_agent_kb
POSTGRES_USER=nx_agent
POSTGRES_PASSWORD=defina_uma_senha_local
# Segredo para assinar o cookie de sessão. Gere um valor aleatório longo, ex.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=troque_por_um_valor_aleatorio_longo
# Emails (separados por vírgula) que viram admin (TI) automaticamente ao logar.
ADMIN_EMAILS=diego.herrera@schwaben.com.br
